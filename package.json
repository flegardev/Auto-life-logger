{
  "name": "auto-life-logger-extension",
  "version": "2.3.0",
  "private": true,
  "description": "Local-first Chrome extension for browsing habit tracking and focus interventions.",
  "author": {
    "name": "Tini Flegar",
    "email": "flegardev@gmail.com",
    "url": "https://github.com/flegardev"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flegardev/Auto-life-logger.git"
  },
  "bugs": {
    "url": "https://github.com/flegardev/Auto-life-logger/issues"
  },
  "homepage": "https://github.com/flegardev/Auto-life-logger#readme",
  "scripts": {
    "lint": "node scripts/validate-extension.js",
    "test": "npm run test:unit && npm run test:chrome && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:chrome": "node scripts/extension-smoke.cjs && node scripts/flagship-journeys.cjs",
    "test:ui": "playwright test tests/ui-smoke.spec.js",
    "smoke": "npm run test",
    "validate": "npm run lint && npm run test",
    "package": "node scripts/package-extension.js",
    "store-assets": "node scripts/generate-store-assets.js",
    "screenshots:final": "node scripts/capture-final-screenshots.js",
    "test:extension": "node scripts/extension-smoke.cjs && node scripts/flagship-journeys.cjs",
    "test:flagship": "node scripts/flagship-journeys.cjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0"
  }
}
